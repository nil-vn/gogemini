# App runtime
APP_ENV=development
SERVER_ADDR=:8080

# Database
DB_DRIVER=sqlite
DB_DSN=file:app.db?cache=shared
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MS=300000

# Security
AUTH_SECRET=change-this-secret

# HTTP
CORS_ORIGIN=*

# Filesystem (Windows-friendly path also supported, e.g. C:\\gogemini\\uploads)
UPLOAD_DIR=static/uploads

# Default admin bootstrap (optional; auto-created on first startup when username/password are set)
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_ROLE=admin
DEFAULT_ADMIN_STATUS=active

# Frontend (Vite dev server)
# Used by frontend app to target backend API base URL.
# Put the same key in frontend/.env when running frontend separately.
VITE_API_BASE=http://localhost:8080
